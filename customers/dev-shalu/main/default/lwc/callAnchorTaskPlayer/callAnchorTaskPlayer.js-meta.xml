<?xml version="1.0" encoding="UTF-8" ?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>65.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>Call Anchor Task Player</masterLabel>
    <description
  >Plays accessible M4A Salesforce Files and the Call Anchor recording linked to a Task: on the Task record page, or on its own page with the Task in c__recordId.</description>
    <targets>
        <target>lightning__RecordPage</target>
        <target>lightning__UrlAddressable</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__RecordPage">
            <objects>
                <object>Task</object>
            </objects>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>
