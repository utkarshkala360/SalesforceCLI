    <decisions>
        <description
    >Ends the flow when an update changed only the next follow-up date/time (e.g. set by the Call Anchor webhook), so no message is re-sent. Continues on create, or when the stage or any other field this flow uses to pick its message changed.</description>
        <name>Skip_Follow_Up_Only_Update</name>
        <label>Skip Follow-Up Only Update</label>
        <locationX>100</locationX>
        <locationY>116</locationY>
        <defaultConnectorLabel
    >Only follow-up date/time changed</defaultConnectorLabel>
        <rules>
            <name>Continue_Flow</name>
            <conditionLogic>(1 AND 2) OR 3 OR 4 OR 5 OR 6</conditionLogic>
            <conditions>
                <leftValueReference
        >$Record.Next_followup_date__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference
        >$Record.Next_Followup_Time__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.StageName</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Brand__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference
        >$Record.Mother_s_Email__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Father_Email__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Faundree_Flow</targetReference>
            </connector>
            <label>Continue Flow</label>
        </rules>
    </decisions>
